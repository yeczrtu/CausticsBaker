#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

Texture2D CausticsTexture;
Texture2D<float4> Guide;
Texture2D<uint> GuideId;
Texture2D<float> GuideCoverage;
Texture2D SceneDepthTexture;
SamplerState BilinearClampSampler;
float4x4 WorldToRegion;
float4x4 RegionToWorld;
float3 RegionSize;
float ProjectionTexelWorldSize;
uint BakeResolution;
uint DebugDisplay;
uint ProjectionMode;

float3 ReconstructGuidePosition(uint2 Pixel, float Depth)
{
    const float2 UV = (float2(Pixel) + 0.5) / BakeResolution;
    const float3 Local = float3(Depth, (UV.x - 0.5) * RegionSize.y, (0.5 - UV.y) * RegionSize.z);
    return mul(float4(Local, 1.0), RegionToWorld).xyz;
}

float4 SampleCoveredCaustics(float2 UV)
{
    float4 Result = CausticsTexture.SampleLevel(BilinearClampSampler, UV, 0);
    // Alpha is receiver coverage. The viewport pass uses additive RGB
    // blending, so coverage has to be applied explicitly to prevent a
    // partially covered edge texel from being composited at full strength.
    Result.rgb *= saturate(Result.a);
    return Result;
}

float4 MainPS(float4 SvPosition : SV_POSITION) : SV_Target0
{
    const uint2 ScenePixel = uint2(SvPosition.xy);
    const float DeviceZ = SceneDepthTexture.Load(int3(ScenePixel, 0)).r;
    if (DeviceZ <= 0.0) return 0.0;
    const float3 WorldPosition = DFHackToFloat(SvPositionToWorld(float4(SvPosition.xy, DeviceZ, 1.0)));
    // Derivatives must be evaluated before per-pixel guide branches diverge.
    const float3 SceneNormalUnnormalized = cross(ddx(WorldPosition), ddy(WorldPosition));
    const float SceneNormalLength2 = dot(SceneNormalUnnormalized, SceneNormalUnnormalized);
    const float3 Local = mul(float4(WorldPosition, 1.0), WorldToRegion).xyz;
    if (Local.x < 0.0 || Local.x > RegionSize.x || abs(Local.y) > RegionSize.y * 0.5 || abs(Local.z) > RegionSize.z * 0.5)
    {
        return 0.0;
    }
    const float2 BakeUV = float2(Local.y / RegionSize.y + 0.5, 0.5 - Local.z / RegionSize.z);

    // The unrestricted legacy mode deliberately repeats the same 2D texel on
    // every depth layer. Surface-aware and strict modes below match the guide
    // plane so a large box cannot stamp a wall caustic onto floors/ceilings.
    if (ProjectionMode == 2u && DebugDisplay <= 3u)
    {
        return SampleCoveredCaustics(BakeUV);
    }

    const uint2 BakePixel = min((uint2)(saturate(BakeUV) * BakeResolution), BakeResolution - 1u);
    const uint ReceiverId = GuideId.Load(int3(BakePixel, 0));
    if (ReceiverId == 0xffffffffu) return 0.0;
    const float4 G = Guide.Load(int3(BakePixel, 0));
    const float Coverage = GuideCoverage.Load(int3(BakePixel, 0));
    if (Coverage <= 0.0) return 0.0;

    const float3 GuideNormal = normalize(G.yzw);
    const float3 GuidePosition = ReconstructGuidePosition(BakePixel, G.x);
    const float PlaneToleranceScale = ProjectionMode == 1u ? 0.5 : 1.0;
    const float PlaneTolerance = max(0.5, ProjectionTexelWorldSize * PlaneToleranceScale);
    if (abs(dot(WorldPosition - GuidePosition, GuideNormal)) > PlaneTolerance) return 0.0;

    // Plane distance alone is zero where two unlike planes intersect. A
    // screen-space geometric normal prevents a narrow wall/ceiling seam from
    // inheriting the other surface's caustic while allowing normal-mapped
    // guide normals through a deliberately loose threshold.
    if (SceneNormalLength2 > 1.0e-8)
    {
        const float3 SceneNormal = SceneNormalUnnormalized * rsqrt(SceneNormalLength2);
        const float NormalThreshold = ProjectionMode == 1u ? 0.5 : 0.2;
        if (abs(dot(SceneNormal, GuideNormal)) < NormalThreshold) return 0.0;
    }

    if (DebugDisplay == 4u) return float4(G.xxx / max(1.0, RegionSize.x), 1.0);
    if (DebugDisplay == 5u) return float4(G.yzw * 0.5 + 0.5, 1.0);
    if (DebugDisplay == 6u)
    {
        return float4(Coverage.xxx, 1.0);
    }
    if (DebugDisplay == 7u)
    {
        const float H = frac(ReceiverId * 0.61803398875);
        return float4(frac(H + float3(0.0, 0.333, 0.667)), 1.0);
    }
    return SampleCoveredCaustics(BakeUV);
}
